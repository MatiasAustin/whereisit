# WhereIsIt - Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Studio Admin Passcode Gate (Default: whereisit2026)
ADMIN_PASSWORD=whereisit2026
ADMIN_PASSCODE=whereisit2026

# Mayar Payment Gateway Headless API V2
# Server-side ONLY. NEVER expose MAYAR_API_KEY to client code!
MAYAR_API_KEY=your_mayar_api_key_here
# Production: https://api.mayar.id/hl/v2 | Sandbox: https://api.mayar.io/hl/v2
MAYAR_API_BASE=https://api.mayar.id/hl/v2

# Mayar Webhook Secret Token
# Endpoint: https://whereisit-coral.vercel.app/api/webhooks/mayar/<MAYAR_WEBHOOK_TOKEN>
MAYAR_WEBHOOK_TOKEN=your_mayar_webhook_token_here

# WhatsApp Studio Admin Contact (WhereIsIt Admin: 6287776523066)
NEXT_PUBLIC_WA_ADMIN_NUMBER=6287776523066

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://whereisit-coral.vercel.app
