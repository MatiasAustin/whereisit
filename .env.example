# WhereIsIt - Supabase Database & Auth Configuration

# Your Supabase Project URL (From Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase Service Role Key (Private - for Route Handlers and Admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Studio Admin Passcode Gate (Default: whereisit2026)
ADMIN_PASSCODE=whereisit2026
